# ---- Telegram (обязательно) ----
# Токен бота от @BotFather
BOT_TOKEN=
# ID администраторов через запятую без пробелов
ADMIN_IDS=

# ---- Режим работы ----
# Пусто = long polling.
# Задан публичный адрес = webhook, например https://ваш-домен.example.com
# (��ез слэша на конце). В режиме webhook работает страница /health.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_SECRET=
HOST=0.0.0.0
PORT=8080

# ---- Данные ----
# ВАЖНО: именно /data, потому что этот каталог вынесен в постоянный том
DB_PATH=/data/shop.db

# ---- Оплата криптой (необязательно) ----
# Токен приложения: @CryptoBot -> Crypto Pay -> Create App
CRYPTO_PAY_TOKEN=
# main - боевая сеть, test - тестовая
CRYPTO_PAY_NETWORK=main
CRYPTO_INVOICE_TTL=900

# ---- Экономика ----
BASE_CURRENCY=USD
CURRENCY_SYMBOL=$
RUB_PER_USD=95
STARS_PER_USD=75
DEFAULT_MARKUP_PERCENT=35
MIN_MARGIN_PERCENT=10

# ---- Поведение ----
QUOTE_TTL_SECONDS=300
LOW_BALANCE_ALERT_CENTS=2000
TRIAL_ENABLED=true
TRIAL_OFFER_ID=
FORCE_CHANNEL_ID=
FORCE_CHANNEL_URL=

# ---- Прочее ----
SHOP_NAME=Proxy Shop
SUPPORT_CONTACT=
LOG_LEVEL=INFO
